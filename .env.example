# Скопировать в .env на сервере и заполнить. .env никому не отправлять.
APP_HOST=app.nurullo-sharipov.tech
POSTGRES_PASSWORD=придумайте_длинный_пароль
OWNER_EMAIL=ваша_почта_владельца
# Параметры существующего Traefik на сервере (посмотреть в его настройках / compose n8n):
TRAEFIK_NETWORK=root_default
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=mytlschallenge
